{
  "name": "@llm-wiki/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for LLM Wiki — exposes the wiki to any MCP-capable LLM client.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts",
    "./port": "./src/port.ts"
  },
  "bin": {
    "llm-wiki-mcp": "./bin/llm-wiki-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "build.mjs"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "node ./bin/llm-wiki-mcp.mjs",
    "start": "node ./bin/llm-wiki-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: no-op for now'"
  },
  "dependencies": {
    "@llm-wiki/core": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
